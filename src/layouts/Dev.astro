---
import '../styles/global.css';
import I18n from '../components/I18n.astro';

const {
  title = 'Ramces Garcia · Software',
  description = 'Software engineer · I build tools and break things.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-side="dev">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Newsreader es la pieza que cambia el registro: serif para prosa larga.
         El lado /sec no la carga, por eso cada lado se siente distinto. -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <I18n />
  </head>
  <body class="dev">
    <slot />
  </body>
</html>

<style is:global>
  /* ============================================================
     /dev — mismo ADN que /sec (morado, oscuro) en otro registro:
     sin rejilla de fondo, mas aire, tipografia mas grande,
     serif para la prosa. Solo aplica dentro de body.dev.
     ============================================================ */
  body.dev {
    /* fuera la rejilla de 48px: este lado respira */
    background-image: none;
    background-color: #0a0810;
    font-size: 17px;
  }

  body.dev .wrap { max-width: 760px; }

  /* --- prosa en serif --- */
  body.dev .prose {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.28rem;
    line-height: 1.6;
    color: var(--text-muted);
    font-weight: 300;
  }
  body.dev .prose strong { color: var(--text); font-weight: 500; }
  body.dev .prose em { color: var(--purple-lit); font-style: italic; }

  /* --- display grande: el gesto que mas cambia la sensacion --- */
  body.dev h1.display {
    font-family: var(--display);
    font-size: clamp(2.8rem, 9vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-weight: 700;
    color: var(--text);
  }

  /* --- secciones separadas por filetes, no por tarjetas --- */
  body.dev .dev-section { padding: 72px 0; border-top: 1px solid var(--border); }
  body.dev .dev-section:first-of-type { border-top: 0; }
  body.dev .dev-section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 28px;
  }
  body.dev h2 {
    font-family: var(--display);
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  @media (max-width: 640px) {
    body.dev .dev-section { padding: 48px 0; }
  }
</style>
