---
import '../styles/global.css';
import I18n from '../components/I18n.astro';

const {
  title = 'Ramces Garcia Sosa',
  description = 'Software engineer. Came to it through security.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-side="dev">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Este lado NO carga Space Grotesk a proposito: es la fuente display
         por defecto de medio internet generado. Aqui el display es serif
         (Newsreader), que casi nadie usa en un portfolio de dev. -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,200;0,6..72,300;0,6..72,400;1,6..72,300&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <I18n />
  </head>
  <body class="dev">
    <slot />
  </body>
</html>

<style is:global>
  /* ============================================================
     /dev — mismo morado que /sec, otro registro.
     Sin rejilla, sin tarjetas, sin pastillas, sin etiquetas de
     seccion en mayusculas. El ritmo es desigual a proposito:
     lo que importa ocupa sitio, lo que no se comprime al final.
     Todo cuelga de body.dev para no tocar el lado /sec.
     ============================================================ */
  body.dev {
    background-image: none;
    background-color: #0a0810;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 19px;
    font-weight: 300;
    color: var(--text-muted);
    line-height: 1.62;
  }

  body.dev .wrap { max-width: 720px; }

  /* El titular rompe la medida del texto: asimetria barata pero real. */
  body.dev .wide { max-width: 940px; }

  body.dev p { margin-bottom: 1.15em; }
  body.dev p:last-child { margin-bottom: 0; }
  body.dev strong { color: var(--text); font-weight: 400; }
  body.dev em { font-style: italic; color: var(--purple-lit); }

  body.dev a { color: var(--text); border-bottom: 1px solid var(--border-lit); }
  body.dev a:hover { color: var(--purple-lit); border-color: var(--purple); }

  body.dev h1 {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 200;
    font-size: clamp(2.6rem, 7.5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  body.dev h2 {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  /* Nada de mono en mayusculas con letterspacing: el mono solo se usa
     donde de verdad hay algo de maquina (la terminal, los metadatos). */
  body.dev .meta {
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 400;
    color: var(--text-dim);
    letter-spacing: 0;
    text-transform: none;
  }
</style>
