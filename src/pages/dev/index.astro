---
import { getCollection } from 'astro:content';
import Dev from '../../layouts/Dev.astro';
import DevNav from '../../components/DevNav.astro';
import Terminal from '../../components/Terminal.astro';

const base = import.meta.env.BASE_URL;

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const da = a.data.date ? a.data.date.getTime() : 0;
    const db = b.data.date ? b.data.date.getTime() : 0;
    return db - da;
  });

const STATUS = {
  shipped:  { en: 'shipped',  es: 'terminado' },
  building: { en: 'building', es: 'en construcción' },
  learning: { en: 'learning', es: 'aprendiendo' },
};

const intro = {
  en: "I write software. I got here through security, which is a strange order to do it in: I spent a year taking apart other people's applications before I started writing my own. It left me with a habit I can't shake — I think about the input nobody validated before I think about the happy path.",
  es: 'Escribo software. Llegué por el lado de la seguridad, que es un orden raro de hacerlo: pasé un año desarmando aplicaciones ajenas antes de escribir las mías. Me dejó una costumbre que no se me quita — pienso en el input que nadie validó antes que en el camino feliz.',
};

// Esta seccion lleva fecha a proposito. Una pagina "ahora" sin fecha no
// dice nada; con fecha dice que alguien la mantiene. Actualizala o quitala.
const nowDate = { en: 'November 2026', es: 'Noviembre 2026' };
const nowText = {
  en: "I'm learning TypeScript and JavaScript properly rather than widely — writing things by hand first and reaching for a library after, which is slower and so far worth it. On the security side I'm working through the CAPE and COAE paths. Most of what I build starts as a small tool for my own pentest work, which is the only way I've found to reliably finish anything.",
  es: 'Estoy aprendiendo TypeScript y JavaScript a fondo en vez de a lo ancho — escribo las cosas a mano primero y tiro de librería después, que es más lento y de momento merece la pena. En el lado de seguridad voy cursando los paths de CAPE y COAE. Casi todo lo que construyo empieza siendo una herramienta pequeña para mi propio trabajo de pentest, que es la única forma que he encontrado de terminar algo de verdad.',
};

const stackText = {
  en: 'TypeScript, JavaScript, Python and bash day to day. Astro for this site. Linux and WSL, because the other half of my work lives there. Git and GitHub Actions.',
  es: 'TypeScript, JavaScript, Python y bash en el día a día. Astro para este sitio. Linux y WSL, porque la otra mitad de mi trabajo vive ahí. Git y GitHub Actions.',
};

const contactText = {
  en: 'Open to software engineering work. The security half of what I do is on the other side of this site.',
  es: 'Abierto a trabajo de ingeniería de software. La mitad de seguridad de lo que hago está en el otro lado de este sitio.',
};

const builtHeading = { en: "What I've built", es: 'Lo que he construido' };
const nowHeading   = { en: 'Right now', es: 'Ahora mismo' };
const stackHeading = { en: 'Tools', es: 'Herramientas' };
const emptyProjects = { en: 'Nothing here yet.', es: 'Aquí todavía no hay nada.' };
---
<Dev title="Ramces Garcia Sosa">
  <DevNav side="dev" />

  <main>
    <!-- ===================== ENTRADA ===================== -->
    <section class="wrap wide opening">
      <h1>Ramces García Sosa</h1>
      <p class="intro" data-i18n-en={intro.en} data-i18n-es={intro.es}>{intro.en}</p>
      <div class="term-slot">
        <Terminal />
      </div>
    </section>

    <!-- ===================== AHORA ===================== -->
    <section class="wrap block">
      <h2 data-i18n-en={nowHeading.en} data-i18n-es={nowHeading.es}>{nowHeading.en}</h2>
      <p class="meta date" data-i18n-en={nowDate.en} data-i18n-es={nowDate.es}>{nowDate.en}</p>
      <p data-i18n-en={nowText.en} data-i18n-es={nowText.es}>{nowText.en}</p>
    </section>

    <!-- ===================== PROYECTOS =====================
         Esta seccion es la que mas sitio ocupa. Es deliberado:
         el ritmo desigual es lo que distingue una pagina de una
         plantilla. Si algun dia hay diez proyectos, el que mas
         te importe va primero con `featured: true`.
    -->
    <section class="wrap block block--major" id="projects">
      <h2 data-i18n-en={builtHeading.en} data-i18n-es={builtHeading.es}>{builtHeading.en}</h2>

      {projects.map((p) => (
        <article class="proj">
          <h3>{p.data.name}</h3>

          <p class="meta">
            {p.data.date && <span>{p.data.date.getFullYear()} · </span>}
            <span>{p.data.stack.join(', ')}</span>
            <span> · </span>
            <span data-i18n-en={STATUS[p.data.status].en} data-i18n-es={STATUS[p.data.status].es}>
              {STATUS[p.data.status].en}
            </span>
          </p>

          <p class="proj-tagline">{p.data.tagline}</p>

          {p.data.highlights.length > 0 && (
            <ul class="proj-highlights">
              {p.data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}

          <p class="meta proj-links">
            {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener">code ↗</a>}
            {p.data.repo && p.data.demo && <span class="sep"> · </span>}
            {p.data.demo && <a href={p.data.demo} target="_blank" rel="noopener">live ↗</a>}
          </p>
        </article>
      ))}

      {projects.length === 0 && (
        <p data-i18n-en={emptyProjects.en} data-i18n-es={emptyProjects.es}>{emptyProjects.en}</p>
      )}
    </section>

    <!-- =====================================================
         AQUI VA LO TUYO.

         Esta es la pieza que hace que una pagina no parezca
         generada: algo que no sirve para que te contraten.
         Gazi tiene una galeria de arte. Arte. No le sirve de
         nada para conseguir trabajo y es justo por eso que su
         sitio se siente de una persona.

         Cuando me contestes las tres preguntas, esto se llena:
           - lo que pondrias que no sirve para que te contraten
           - como le explicas a un amigo lo que haces
           - en que te metes demasiado a fondo

         Hasta entonces va comentado: una seccion vacia con un
         titulo de relleno seria peor que no tenerla.

    <section class="wrap block">
      <h2>...</h2>
      <p>...</p>
    </section>
    -->

    <!-- ===================== COLA =====================
         Herramientas y contacto van comprimidos y en pequeno:
         son informacion de referencia, no argumento.
    -->
    <section class="wrap block block--minor">
      <h2 data-i18n-en={stackHeading.en} data-i18n-es={stackHeading.es}>{stackHeading.en}</h2>
      <p class="small" data-i18n-en={stackText.en} data-i18n-es={stackText.es}>{stackText.en}</p>
    </section>

    <footer class="wrap block block--minor" id="contact">
      <p class="small" data-i18n-en={contactText.en} data-i18n-es={contactText.es}>{contactText.en}</p>
      <p class="meta links">
        <a href="mailto:ramcesgarciasosa2005@gmail.com">ramcesgarciasosa2005@gmail.com</a>
        <span class="sep"> · </span>
        <a href="https://github.com/beserker34" target="_blank" rel="noopener">github</a>
        <span class="sep"> · </span>
        <a href={base} data-i18n-en="security work" data-i18n-es="trabajo de seguridad">security work</a>
      </p>
    </footer>
  </main>
</Dev>

<style>
  /* --- ritmo desigual: cada bloque pesa lo que debe pesar --- */
  .opening { padding: 96px 0 0; }
  .block { padding: 72px 0 0; }
  .block--major { padding-top: 104px; }
  .block--minor { padding-top: 56px; }
  footer.block { padding-bottom: 96px; }

  .intro { font-size: 1.32rem; line-height: 1.52; max-width: 30em; margin-top: 30px; }
  .term-slot { margin-top: 56px; max-width: 46em; }

  .date { margin: -2px 0 14px; }

  .proj { margin-top: 44px; }
  .proj:first-of-type { margin-top: 28px; }
  .proj h3 {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 400;
    font-size: 1.32rem;
    color: var(--text);
    line-height: 1.3;
  }
  .proj .meta { margin: 6px 0 16px; }
  .proj-tagline { color: var(--text-muted); }

  /* Viñetas normales. Un glifo decorativo propio en cada linea es
     justo el tipo de detalle que delata una plantilla. */
  .proj-highlights {
    margin: 0 0 18px 1.1em;
    padding: 0;
    font-size: 0.97rem;
    color: var(--text-muted);
  }
  .proj-highlights li { margin-bottom: 8px; padding-left: 4px; }
  .proj-highlights li::marker { color: var(--border-lit); }

  .proj-links a { border-bottom-color: var(--border); }
  .sep { color: var(--text-dim); }

  .small { font-size: 1.02rem; color: var(--text-muted); max-width: 40em; }
  .links { margin-top: 18px; }
  .links a { border-bottom-color: var(--border); }

  @media (max-width: 640px) {
    .opening { padding-top: 56px; }
    .block { padding-top: 52px; }
    .block--major { padding-top: 68px; }
    .intro { font-size: 1.15rem; margin-top: 22px; }
    .term-slot { margin-top: 36px; }
  }
</style>
