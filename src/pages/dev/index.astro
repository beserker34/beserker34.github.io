---
import { getCollection } from 'astro:content';
import Dev from '../../layouts/Dev.astro';
import DevNav from '../../components/DevNav.astro';
import Terminal from '../../components/Terminal.astro';

const base = import.meta.env.BASE_URL;

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const da = a.data.date ? a.data.date.getTime() : 0;
    const db = b.data.date ? b.data.date.getTime() : 0;
    return db - da;
  });

const STATUS = {
  shipped:  { en: 'shipped',  es: 'terminado' },
  building: { en: 'building', es: 'en construcción' },
  learning: { en: 'learning', es: 'aprendiendo' },
};

const intro = {
  en: "I'm a software engineer who came to code through offensive security. For a year I audited other people's applications — so when I build my own, I reach for the unvalidated input before the happy path. That's my edge: I write code thinking about how it breaks, not just how it works.",
  es: 'Soy ingeniero de software que llegó al código por la seguridad ofensiva. Durante un año audité aplicaciones ajenas — así que cuando construyo las mías, voy al input sin validar antes que al camino feliz. Esa es mi ventaja: escribo código pensando en cómo se rompe, no solo en cómo funciona.',
};

// Lleva fecha a proposito: dice que hay alguien manteniendo esto.
const foundationDate = { en: 'November 2026', es: 'Noviembre 2026' };

const foundation = {
  en: "My foundation isn't self-taught by accident. I'm working through a self-designed curriculum built on MIT's OpenCourseWare 6-3 track, following the real prerequisite chain instead of chasing tutorials: CS fundamentals in Python, then C and assembly, data structures, algorithms, and systems. I pair it with daily algorithmic practice on LeetCode.",
  es: 'Que sea autodidacta no es por casualidad. Sigo un plan de estudios propio montado sobre el track 6-3 del OpenCourseWare del MIT, respetando la cadena real de prerrequisitos en vez de ir saltando de tutorial en tutorial: fundamentos de CS en Python, luego C y ensamblador, estructuras de datos, algoritmos y sistemas. Lo acompaño con práctica algorítmica diaria en LeetCode.',
};

const foundationClose = {
  en: "The goal isn't to finish a course. It's to understand software from the logic gate up.",
  es: 'El objetivo no es terminar un curso. Es entender el software desde la puerta lógica hacia arriba.',
};

// La cadena de prerrequisitos, en el orden real en que se cursa.
// Las flechas aqui significan "habilita", no son decoracion.
const chain = ['python', 'c & assembly', 'data structures', 'algorithms', 'systems'];

const projectsIntro = {
  en: 'My projects usually start as small security tools and grow from there. I ship real things, document my work in the open, and care more about craft and correctness than collecting credentials.',
  es: 'Mis proyectos suelen empezar siendo herramientas pequeñas de seguridad y crecen desde ahí. Publico cosas que funcionan, documento mi trabajo en abierto, y me importa más el oficio y la corrección que coleccionar credenciales.',
};

const stackText = {
  en: 'Python, TypeScript, JavaScript and bash day to day; C and assembly as the curriculum reaches them. Astro for this site. Linux and WSL, because the other half of my work lives there. Git and GitHub Actions.',
  es: 'Python, TypeScript, JavaScript y bash en el día a día; C y ensamblador según los va alcanzando el plan. Astro para este sitio. Linux y WSL, porque la otra mitad de mi trabajo vive ahí. Git y GitHub Actions.',
};

const footerText = {
  en: 'Bilingual (Spanish/English) · Dominican Republic · Open to remote software engineering roles.',
  es: 'Bilingüe (español/inglés) · República Dominicana · Abierto a roles remotos de ingeniería de software.',
};

const foundationHeading = { en: 'Foundation', es: 'Formación' };
const builtHeading      = { en: "What I've built", es: 'Lo que he construido' };
const stackHeading      = { en: 'Tools', es: 'Herramientas' };
const emptyProjects     = { en: 'Nothing here yet.', es: 'Aquí todavía no hay nada.' };
---
<Dev title="Ramces Garcia Sosa">
  <DevNav side="dev" />

  <main>
    <!-- ===================== ENTRADA ===================== -->
    <section class="wrap wide opening">
      <h1>Ramces García Sosa</h1>
      <p class="intro" data-i18n-en={intro.en} data-i18n-es={intro.es}>{intro.en}</p>
      <div class="term-slot">
        <Terminal />
      </div>
    </section>

    <!-- ===================== FORMACION =====================
         Esta es la seccion con mas peso de la pagina y es
         deliberado: el curriculo propio sobre el 6-3 del MIT es
         lo mas especifico que hay aqui, y lo especifico es lo
         que hace que una pagina no parezca una plantilla.
    -->
    <section class="wrap block block--major" id="foundation">
      <h2 data-i18n-en={foundationHeading.en} data-i18n-es={foundationHeading.es}>{foundationHeading.en}</h2>
      <p class="meta date" data-i18n-en={foundationDate.en} data-i18n-es={foundationDate.es}>{foundationDate.en}</p>

      <p class="lead" data-i18n-en={foundation.en} data-i18n-es={foundation.es}>{foundation.en}</p>

      <p class="chain mono">
        {chain.map((step, i) => (
          <>
            {i > 0 && <span class="chain-arrow" aria-hidden="true">→</span>}
            <span class="chain-step">{step}</span>
          </>
        ))}
      </p>

      <p class="close" data-i18n-en={foundationClose.en} data-i18n-es={foundationClose.es}>{foundationClose.en}</p>
    </section>

    <!-- ===================== PROYECTOS ===================== -->
    <section class="wrap block" id="projects">
      <h2 data-i18n-en={builtHeading.en} data-i18n-es={builtHeading.es}>{builtHeading.en}</h2>
      <p class="section-intro" data-i18n-en={projectsIntro.en} data-i18n-es={projectsIntro.es}>{projectsIntro.en}</p>

      {projects.map((p) => (
        <article class="proj">
          <h3>{p.data.name}</h3>

          <p class="meta">
            {p.data.date && <span>{p.data.date.getFullYear()} · </span>}
            <span>{p.data.stack.join(', ')}</span>
            <span> · </span>
            <span data-i18n-en={STATUS[p.data.status].en} data-i18n-es={STATUS[p.data.status].es}>
              {STATUS[p.data.status].en}
            </span>
          </p>

          <p class="proj-tagline">{p.data.tagline}</p>

          {p.data.highlights.length > 0 && (
            <ul class="proj-highlights">
              {p.data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}

          <p class="meta proj-links">
            {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener">code ↗</a>}
            {p.data.repo && p.data.demo && <span class="sep"> · </span>}
            {p.data.demo && <a href={p.data.demo} target="_blank" rel="noopener">live ↗</a>}
          </p>
        </article>
      ))}

      {projects.length === 0 && (
        <p data-i18n-en={emptyProjects.en} data-i18n-es={emptyProjects.es}>{emptyProjects.en}</p>
      )}
    </section>

    <!-- =====================================================
         AQUI VA LO TUYO.

         Falta todavia la pieza que no sirve para que te
         contraten: musica, dibujo, un juego, una obsesion rara.
         Gazi tiene una galeria de arte, que no le sirve de nada
         para conseguir trabajo, y es justo por eso que su sitio
         se siente de una persona.

         Va comentado hasta que me digas que es: una seccion
         vacia con titulo de relleno seria peor que no tenerla.

    <section class="wrap block">
      <h2>...</h2>
      <p>...</p>
    </section>
    -->

    <!-- ===================== COLA ===================== -->
    <section class="wrap block block--minor">
      <h2 data-i18n-en={stackHeading.en} data-i18n-es={stackHeading.es}>{stackHeading.en}</h2>
      <p class="small" data-i18n-en={stackText.en} data-i18n-es={stackText.es}>{stackText.en}</p>
    </section>

    <footer class="wrap block block--minor" id="contact">
      <p class="small" data-i18n-en={footerText.en} data-i18n-es={footerText.es}>{footerText.en}</p>
      <p class="meta links">
        <a href="mailto:ramcesgarciasosa2005@gmail.com">ramcesgarciasosa2005@gmail.com</a>
        <span class="sep"> · </span>
        <a href="https://github.com/beserker34" target="_blank" rel="noopener">github</a>
        <span class="sep"> · </span>
        <a href={base} data-i18n-en="security work" data-i18n-es="trabajo de seguridad">security work</a>
      </p>
    </footer>
  </main>
</Dev>

<style>
  /* --- ritmo desigual: cada bloque pesa lo que debe pesar --- */
  .opening { padding: 96px 0 0; }
  .block { padding: 72px 0 0; }
  .block--major { padding-top: 104px; }
  .block--minor { padding-top: 56px; }
  footer.block { padding-bottom: 96px; }

  .intro { font-size: 1.32rem; line-height: 1.52; max-width: 30em; margin-top: 30px; }
  .term-slot { margin-top: 56px; max-width: 46em; }

  .date { margin: -2px 0 16px; }
  .lead { font-size: 1.12rem; max-width: 38em; }
  .close { max-width: 34em; color: var(--text); }
  .section-intro { max-width: 38em; margin-bottom: 8px; }

  /* La cadena de prerrequisitos. Las flechas son semanticas
     (habilita), no adorno, y por eso se quedan. */
  .chain {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55em;
    font-size: 0.78rem;
    margin: 26px 0 28px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .chain-step { color: var(--text-muted); }
  .chain-step:first-of-type { color: var(--purple-lit); }
  .chain-arrow { color: var(--text-dim); }

  .proj { margin-top: 44px; }
  .proj h3 {
    font-family: 'Newsreader', Georgia, serif;
    font-weight: 400;
    font-size: 1.32rem;
    color: var(--text);
    line-height: 1.3;
  }
  .proj .meta { margin: 6px 0 16px; }
  .proj-tagline { color: var(--text-muted); }

  /* Viñetas normales: un glifo decorativo propio en cada linea
     es justo el detalle que delata una plantilla. */
  .proj-highlights {
    margin: 0 0 18px 1.1em;
    padding: 0;
    font-size: 0.97rem;
    color: var(--text-muted);
  }
  .proj-highlights li { margin-bottom: 8px; padding-left: 4px; }
  .proj-highlights li::marker { color: var(--border-lit); }

  .proj-links a { border-bottom-color: var(--border); }
  .sep { color: var(--text-dim); }

  .small { font-size: 1.02rem; color: var(--text-muted); max-width: 40em; }
  .links { margin-top: 18px; }
  .links a { border-bottom-color: var(--border); }

  @media (max-width: 640px) {
    .opening { padding-top: 56px; }
    .block { padding-top: 52px; }
    .block--major { padding-top: 68px; }
    .intro { font-size: 1.15rem; margin-top: 22px; }
    .term-slot { margin-top: 36px; }
    .chain { font-size: 0.72rem; gap: 0.4em; }
  }
</style>
