---
// Métricas reales del perfil HTB (actualiza cuando cambien).
const stats = [
  { label: 'HTB Rank',  labelKey: null,               value: 'Master',   sub: 'Level 73',        subKey: 'stats.sub.level' },
  { label: 'Season 11', labelKey: null,               value: '#883',     sub: 'Holo Tier · 720 pts', subKey: null },
  { label: 'Machines',  labelKey: 'stats.label.machines', value: '59',   sub: 'solved',          subKey: 'stats.sub.solved' },
  { label: 'Weekly streak', labelKey: 'stats.label.streak', value: '27', sub: 'weeks · record',  subKey: 'stats.sub.weeks' },
  { label: 'Flags',     labelKey: null,               value: '24/26',    sub: 'season',          subKey: null },
  { label: 'Member since', labelKey: 'stats.label.member', value: 'Nov 2025', sub: 'Dominican Republic', subKey: 'stats.sub.country' },
];
---
<section id="stats">
  <div class="wrap">
    <div class="section-head">
      <span class="idx mono">02</span>
      <h2 data-i18n="stats.title">Stats</h2>
      <span class="dim mono" style="font-size:.78rem">// hackthebox.com/users/2881312</span>
    </div>
    <div class="metrics">
      {stats.map((s) => (
        <div class="card metric">
          <span class="m-label mono" data-i18n={s.labelKey ?? undefined}>{s.label}</span>
          <span class="m-value">{s.value}</span>
          <span class="m-sub mono" data-i18n={s.subKey ?? undefined}>{s.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .metric { padding: 20px; display: flex; flex-direction: column; gap: 4px; }
  .metric:hover { transform: translateY(-2px); }
  .m-label { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
  .m-value { font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--purple-lit); line-height: 1.1; }
  .m-sub { font-size: 0.75rem; color: var(--text-muted); }
  @media (max-width: 720px) { .metrics { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .metrics { grid-template-columns: 1fr; } }
</style>
