---
// Métricas reales del perfil HTB (actualiza cuando cambien).
const stats = [
  { label: 'HTB Rank',        value: 'Master',   sub: 'Nivel 73' },
  { label: 'Season 11',       value: '#883',     sub: 'Holo Tier · 720 pts' },
  { label: 'Máquinas',        value: '59',       sub: 'resueltas' },
  { label: 'Racha semanal',   value: '27',       sub: 'semanas · récord' },
  { label: 'Flags',           value: '24/26',    sub: 'season' },
  { label: 'Miembro desde',   value: 'Nov 2025', sub: 'Dominican Republic' },
];
---
<section id="stats">
  <div class="wrap">
    <div class="section-head">
      <span class="idx mono">02</span>
      <h2>Stats</h2>
      <span class="dim mono" style="font-size:.78rem">// hackthebox.com/users/2881312</span>
    </div>
    <div class="metrics">
      {stats.map((s) => (
        <div class="card metric">
          <span class="m-label mono">{s.label}</span>
          <span class="m-value">{s.value}</span>
          <span class="m-sub mono">{s.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .metric { padding: 20px; display: flex; flex-direction: column; gap: 4px; }
  .metric:hover { transform: translateY(-2px); }
  .m-label { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
  .m-value { font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--purple-lit); line-height: 1.1; }
  .m-sub { font-size: 0.75rem; color: var(--text-muted); }
  @media (max-width: 720px) { .metrics { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .metrics { grid-template-columns: 1fr; } }
</style>
