---
const base = import.meta.env.BASE_URL;
// `side` marca cual de las dos puertas esta activa: 'dev' | 'sec'
const { side = 'dev' } = Astro.props;
---
<nav class="nav dev-nav">
  <div class="wrap nav-inner">
    <a href={base} class="brand mono">4PR3ND1Z<span class="cursor">_</span></a>

    <div class="switch mono" role="group" aria-label="Portfolio">
      <a href={base} class={side === 'sec' ? 'is-active' : ''}>sec</a>
      <a href={`${base}dev/`} class={side === 'dev' ? 'is-active' : ''}>dev</a>
    </div>

    <div class="lang mono" role="group" aria-label="Language">
      <button class="lang-btn is-active" data-lang="en" type="button">EN</button>
      <button class="lang-btn" data-lang="es" type="button">ES</button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, #0a0810 82%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { font-weight: 700; font-size: 0.95rem; letter-spacing: 0.08em; color: var(--text); }
  .cursor { color: var(--purple); animation: blink 1.1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* el conmutador entre los dos portfolios: mismo lenguaje que el de idioma */
  .switch { display: flex; gap: 2px; border: 1px solid var(--border); border-radius: 5px; padding: 2px; }
  .switch a {
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 3px;
    transition: color .16s ease, background .16s ease;
  }
  .switch a:hover { color: var(--text); }
  .switch a.is-active { color: var(--purple-lit); background: var(--surface-2); }

  .lang { display: flex; gap: 2px; border: 1px solid var(--border); border-radius: 5px; padding: 2px; }
  .lang-btn {
    background: transparent; border: none; color: var(--text-dim);
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.06em;
    padding: 3px 8px; border-radius: 3px; cursor: pointer;
    transition: color .16s ease, background .16s ease;
  }
  .lang-btn:hover { color: var(--text); }
  .lang-btn.is-active { color: var(--purple-lit); background: var(--surface-2); }

  @media (max-width: 560px) {
    .brand { font-size: 0.85rem; }
    .switch a { padding: 4px 9px; }
  }
</style>
