---
const base = import.meta.env.BASE_URL;
---
<header class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="tag prompt">whoami</p>
      <h1>Ramces <span class="hl">"4PR3ND1Z"</span></h1>
      <p class="pitch mono" data-i18n="hero.pitch">Offensive Security · Web &amp; Business Logic · Red Team</p>
      <p class="blurb" data-i18n="hero.blurb" data-i18n-html>
        Offensive security professional (Dominican Republic). Certified <strong>CPTS</strong> and <strong>CWES</strong>,
        currently completing <strong>CWEE</strong>. I specialize in web exploitation, IDOR, and business logic
        flaws — where scanners don't reach.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={`${base}#writeups`} data-i18n="hero.cta.writeups">View writeups</a>
        <a class="btn" href="https://app.hackthebox.com/users/2881312" target="_blank" rel="noopener">HTB Profile ↗</a>
        <a class="btn" href="https://hackerone.com/4pr3nd1z" target="_blank" rel="noopener">HackerOne ↗</a>
      </div>
    </div>

    <div class="avatar-col" aria-hidden="true">
      <div class="avatar-frame">
        <img src={`${base}img/avatar.jpg`} alt="" width="220" height="220" loading="eager" />
      </div>
      <div class="badge-float badge-float--htb">
        <img src={`${base}img/badge-htb.svg`} alt="HackTheBox" width="20" height="20" />
      </div>
      <div class="badge-float badge-float--cpts">
        <img src={`${base}img/badge-cpts.png`} alt="CPTS" width="34" height="34" />
      </div>
      <div class="badge-float badge-float--cwes">
        <img src={`${base}img/badge-cwes.png`} alt="CWES" width="34" height="34" />
      </div>
    </div>
  </div>
</header>

<style>
  .hero { padding: 84px 0 72px; }
  .hero-inner {
    max-width: 900px;
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .hero-text { flex: 1 1 420px; min-width: 280px; }
  h1 { font-size: clamp(2.4rem, 7vw, 4rem); margin: 10px 0 6px; }
  .hl { color: var(--purple); }
  .pitch {
    font-size: clamp(0.85rem, 2.6vw, 1.05rem);
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin-bottom: 22px;
  }
  .blurb { font-size: 1.05rem; color: var(--text-muted); max-width: 60ch; margin-bottom: 30px; }
  .blurb strong { color: var(--text); font-weight: 600; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* --- avatar + insignias flotantes --- */
  .avatar-col {
    position: relative;
    width: 220px;
    height: 220px;
    flex: 0 0 220px;
  }
  .avatar-frame {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border-lit);
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--border);
    background: var(--surface);
  }
  .avatar-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .badge-float {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--border-lit);
    animation: float 5.5s ease-in-out infinite;
  }
  .badge-float--htb  { top: -4px; right: 6px; width: 38px; height: 38px; animation-duration: 4.6s; }
  .badge-float--cpts { bottom: 10px; left: -16px; width: 50px; height: 50px; animation-duration: 6s; animation-delay: .4s; }
  .badge-float--cwes { bottom: -12px; right: -8px; width: 50px; height: 50px; animation-duration: 5.2s; animation-delay: 1s; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-9px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-float { animation: none; }
  }

  @media (max-width: 760px) {
    .hero-inner { flex-direction: column-reverse; text-align: center; gap: 28px; }
    .cta { justify-content: center; }
  }
  @media (max-width: 560px) {
    .hero { padding: 52px 0 44px; }
    .avatar-col { width: 168px; height: 168px; flex-basis: 168px; }
    .avatar-frame { width: 168px; height: 168px; }
    .badge-float--cpts, .badge-float--cwes { width: 40px; height: 40px; }
  }
</style>
