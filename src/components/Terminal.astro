---
// ============================================================
//  TERMINAL  —  ESQUELETO
//
//  No tiene marco ni barra de ventana: el prompt vive directamente
//  sobre la pagina, como parte del texto del hero. Una ventana falsa
//  dentro de una pagina es el cliche numero uno de los portfolios de
//  dev, asi que no la queremos.
//
//  La maqueta y los estilos estan hechos. Falta la logica.
//
//  Orden sugerido (cada paso funciona solo, pruebalo antes del siguiente):
//    1. Capturar lo que se teclea y pintarlo tras el prompt.
//    2. Al pulsar Enter: mover la linea al historial y limpiar.
//    3. Un objeto COMMANDS { nombre: () => 'salida' } y buscar en el.
//    4. Comando no encontrado -> mensaje de error.
//    5. Historial con flechas arriba/abajo.
//    6. Autocompletado con Tab.
//
//  Pista para el paso 1: el <input> real esta oculto (opacity 0) encima
//  de la linea. Lo que se ve es el <span id="term-typed">. Escuchas
//  'input' y copias su .value al span. Asi el cursor es un elemento que
//  puedes estilar y el teclado del movil sigue funcionando.
// ============================================================
---
<div class="term" id="term">
  <div id="term-history"></div>

  <label class="term-line mono" for="term-input">
    <span class="term-prompt">$</span><span id="term-typed"></span><span class="term-cursor" aria-hidden="true"></span>
    <input
      id="term-input"
      class="term-input"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Terminal"
    />
  </label>

  <p class="term-hint mono" data-i18n-en="try: whoami, ls, about" data-i18n-es="prueba: whoami, ls, about">
    try: whoami, ls, about
  </p>
</div>

<script>
  // --- PASO 0: los elementos con los que vas a trabajar ---
  const term    = document.getElementById('term');
  const input   = document.getElementById('term-input');
  const typed   = document.getElementById('term-typed');
  const history = document.getElementById('term-history');

  if (term && input && typed && history) {
    // Clic en cualquier parte -> el foco va al input.
    term.addEventListener('click', () => input.focus());

    // --- PASO 1: reflejar lo tecleado ---
    // input.addEventListener('input', () => { ... });
    //   -> copia input.value dentro de typed.textContent

    // --- PASO 2: ejecutar al pulsar Enter ---
    // input.addEventListener('keydown', (e) => {
    //   if (e.key !== 'Enter') return;
    //   const raw = input.value.trim();
    //   if (!raw) return;
    //   printLine(raw);
    //   printOut(run(raw));
    //   input.value = '';
    //   typed.textContent = '';
    // });

    // --- PASO 3: la tabla de comandos ---
    // Cada uno devuelve el texto a imprimir. Empieza con dos o tres.
    //
    // const COMMANDS = {
    //   help:    () => 'available: ' + Object.keys(COMMANDS).join(', '),
    //   whoami:  () => '...',
    //   ls:      () => 'projects/  writeups/  about.txt',
    //   clear:   () => { history.innerHTML = ''; return ''; },
    // };

    // --- PASO 4: resolver ---
    // function run(raw) {
    //   const [name, ...args] = raw.split(/\s+/);
    //   const cmd = COMMANDS[name];
    //   if (!cmd) return `command not found: ${name} — try 'help'`;
    //   return cmd(args);
    // }

    // --- Ayudantes de pintado (estos si te los dejo hechos) ---
    // Usan textContent, nunca innerHTML. Si pintaras con innerHTML lo que
    // teclea el visitante tendrias un XSS en tu propio portfolio, que
    // viniendo de seguridad seria mal chiste.
    function printLine(text) {
      const p = document.createElement('p');
      p.className = 'term-line mono';
      const prompt = document.createElement('span');
      prompt.className = 'term-prompt';
      prompt.textContent = '$';
      p.append(prompt, text);
      history.appendChild(p);
    }

    function printOut(text) {
      if (!text) return;
      const p = document.createElement('p');
      p.className = 'term-out mono';
      p.textContent = text;
      history.appendChild(p);
    }
  }
</script>

<style>
  .term { cursor: text; }

  .term-line {
    position: relative;
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--text);
  }
  .term-prompt { color: var(--purple); margin-right: 0.6ch; user-select: none; }
  .term-out {
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--text-muted);
    padding-left: 1.6ch;
    white-space: pre-wrap;
  }

  /* El input real es invisible pero recibe el teclado: asi el cursor es
     un elemento que puedo estilar y el movil sigue funcionando. */
  .term-input {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    opacity: 0;
    border: 0; outline: none; background: transparent;
    font: inherit; color: transparent;
    cursor: text;
  }

  .term-cursor {
    display: inline-block;
    width: 8px; height: 1.05em;
    background: var(--purple);
    vertical-align: text-bottom;
    animation: term-blink 1.1s step-end infinite;
  }
  @keyframes term-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .term-cursor { animation: none; } }

  .term-hint {
    font-size: 0.72rem;
    color: var(--text-dim);
    padding-left: 1.6ch;
    margin-top: 2px;
  }
  .term:focus-within .term-hint { opacity: 0; transition: opacity .2s ease; }
</style>
