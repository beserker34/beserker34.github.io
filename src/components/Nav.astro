---
const base = import.meta.env.BASE_URL;
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a href={base} class="brand mono">4PR3ND1Z<span class="cursor">_</span></a>
    <div class="links mono">
      <a href={`${base}#writeups`}>writeups</a>
      <a href={`${base}#certs`}>certs</a>
      <a href={`${base}#prolabs`}>pro labs</a>
      <a href={`${base}#stats`}>stats</a>
      <a href={`${base}#contact`}>contact</a>
    </div>
    <div class="lang mono" role="group" aria-label="Language">
      <button class="lang-btn is-active" data-lang="en" type="button">EN</button>
      <button class="lang-btn" data-lang="es" type="button">ES</button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--text);
  }
  .cursor { color: var(--purple); animation: blink 1.1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .links { display: flex; gap: 22px; font-size: 0.82rem; }
  .links a { color: var(--text-muted); }
  .links a:hover { color: var(--purple-lit); }
  .lang { display: flex; gap: 2px; margin-left: 18px; border: 1px solid var(--border); border-radius: 5px; padding: 2px; }
  .lang-btn {
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 3px;
    cursor: pointer;
    transition: color .16s ease, background .16s ease;
  }
  .lang-btn:hover { color: var(--text); }
  .lang-btn.is-active { color: var(--purple-lit); background: var(--surface-2); }
  @media (max-width: 560px) { .links { gap: 14px; font-size: 0.75rem; } .lang { margin-left: 10px; } }
</style>
