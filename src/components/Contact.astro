---
const links = [
  { label: 'YouTube',   handle: '@4Pr3nd1z0',   url: 'https://www.youtube.com/@4Pr3nd1z0' },
  { label: 'HackerOne', handle: '4pr3nd1z',      url: 'https://hackerone.com/4pr3nd1z' },
  { label: 'HackTheBox',handle: 'user/2881312',  url: 'https://app.hackthebox.com/users/2881312' },
  { label: 'GitHub',    handle: 'beserker34',    url: 'https://github.com/beserker34' },
];
---
<section id="contact">
  <div class="wrap">
    <div class="section-head">
      <span class="idx mono">05</span>
      <h2 data-i18n="contact.title">Contact</h2>
    </div>
    <div class="contact-grid">
      {links.map((l) => (
        <a class="card clink" href={l.url} target="_blank" rel="noopener">
          <span class="cl-label mono">{l.label}</span>
          <span class="cl-handle">{l.handle}</span>
          <span class="cl-arrow mono">↗</span>
        </a>
      ))}
    </div>
    <p class="cv">
      <a class="btn btn-primary" href="/cv.pdf" download data-i18n="contact.cv">Download CV (PDF)</a>
    </p>
  </div>
  <footer class="foot">
    <div class="wrap mono">
      <span>© {new Date().getFullYear()} 4PR3ND1Z</span>
      <span class="dim" data-i18n="contact.footer.tag">Offensive Security · Dominican Republic</span>
    </div>
  </footer>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 28px; }
  .clink { display: flex; align-items: center; gap: 12px; padding: 18px 20px; }
  .clink:hover { transform: translateY(-2px); }
  .cl-label { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--purple); min-width: 92px; }
  .cl-handle { color: var(--text); font-size: 0.95rem; }
  .cl-arrow { margin-left: auto; color: var(--text-dim); }
  .cv { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .foot {
    margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--border);
  }
  .foot .wrap { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--text-muted); }
  @media (max-width: 560px) {
    .contact-grid { grid-template-columns: 1fr; }
    .foot .wrap { flex-direction: column; gap: 6px; }
  }
</style>
